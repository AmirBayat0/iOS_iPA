<?xml version="1.0" encoding="utf-8"?>
<!--
  Beschreibung des Widgets für den Startbildschirm.

  minWidth/minHeight gelten für alte Android-Versionen und beschreiben
  2x1 Zellen; targetCellWidth/Height sagen dasselbe ab Android 12 in der
  Sprache, die der Startbildschirm dort versteht.

  updatePeriodMillis ist der kleinste Wert, den Android zulässt (30 Minuten).
  Gezeichnet wird dabei nichts Neues berechnet — das Widget vergleicht nur die
  Uhr mit dem hinterlegten Umschaltzeitpunkt. Genau dafür ist der Takt da:
  Geht morgens das Fajr-Fenster auf, wechselt die Anzeige von allein, auch
  wenn die App seit dem Abend nicht lief.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="60dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:maxResizeWidth="320dp"
    android:maxResizeHeight="120dp"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_klein"
    android:previewLayout="@layout/widget_klein"
    android:description="@string/widget_beschreibung"
    android:widgetCategory="home_screen" />
